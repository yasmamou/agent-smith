# ============================================================
#  Agent Smith — environment variables
# ============================================================

# ---- Database ----
# Local dev (SQLite, default): no setup required.
DATABASE_URL="file:./dev.db"
# Production (Vercel) — switch prisma/schema.prisma provider to "postgresql"
# and use a Neon / Supabase connection string instead, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ---- Auth ----
# Secret used to sign session cookies. Use a long random value in prod.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- AI provider (optional, enables hybrid agents) ----
# Choose with AI_PROVIDER: "claude-cli" | "anthropic" | "openai".
#  - claude-cli: use the local Claude Code CLI (`claude -p`) as the brain.
#    Tokens go through your Claude Code session, NO API key needed. (or CLAUDE_CLI=1)
#  - anthropic: Claude API (preferred among keys). openai: fallback.
# Without any of these, a deterministic writer is used.
AI_PROVIDER=""
CLAUDE_CLI=""
# CLAUDE_CLI_BIN="claude"   # path to the claude binary if not on PATH
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Remote browser for serverless audits (pick ONE) ----
# Option A — Self-hosted / any remote Chrome over CDP (vendor-neutral, no quota).
# e.g. browserless: wss://your-host.up.railway.app?token=YOUR_TOKEN
# Takes priority over Browserbase. See SELF_HOSTED_BROWSER.md.
BROWSER_CDP_URL=""

# Option B — Browserbase managed Chrome (convenience SaaS; free tier ≈ 1 session).
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""

# How many remote sessions may run at once (DB semaphore). Free tiers ≈ 1.
BROWSER_CONCURRENCY="1"

# ---- Queue (optional) ----
# If set, /api/queue/process requires this (Vercel Cron sends CRON_SECRET).
CRON_SECRET=""
QUEUE_SECRET=""

# ---- Billing (optional, Stripe) — credits work without it ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Alternative (optional) — Supabase, if you wire Supabase Auth/DB later.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---- Audit engine ----
# Leave empty to auto-detect (real Playwright locally, mock on serverless).
# Force with "playwright" or "mock".
AUDIT_ENGINE=""
