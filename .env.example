# ============================================================
#  Agent Smith — environment variables
# ============================================================

# ---- Database ----
# Local dev (SQLite, default): no setup required.
DATABASE_URL="file:./dev.db"
# Production (Vercel) — switch prisma/schema.prisma provider to "postgresql"
# and use a Neon / Supabase connection string instead, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ---- Auth ----
# Secret used to sign session cookies. Use a long random value in prod.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- AI (optional) ----
# When set, Agent Smith uses Claude to write the executive narrative and
# polish the fix prompt. Without it, a deterministic writer is used.
ANTHROPIC_API_KEY=""

# Alternative (optional) — Supabase, if you wire Supabase Auth/DB later.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---- Audit engine ----
# Leave empty to auto-detect (real Playwright locally, mock on serverless).
# Force with "playwright" or "mock".
AUDIT_ENGINE=""
