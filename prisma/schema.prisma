// Agent Smith — Prisma schema
// Dev: SQLite (zero-setup). Production (Vercel): switch `provider` to
// "postgresql" and point DATABASE_URL at Neon/Supabase. See README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  plan         String   @default("free") // free | starter | pro | team
  apiKeyHash   String?  @unique // sha256 of the API key (never store the key in clear)
  apiKeyPrefix String?  // first chars, for display only
  credits      Int      @default(15) // audit credits; granted on signup, spent per real audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  audits       Audit[]
  customAgents CustomAgent[]
  creditTxns   CreditTxn[]
  trackedSites TrackedSite[]
}

// Append-only ledger of every credit movement (grant / spend / refund / purchase).
// The User.credits column is the running balance; each row records the delta and
// the resulting balance for a full audit trail.
model CreditTxn {
  id        String   @id @default(cuid())
  userId    String
  delta     Int      // +grant/+purchase/+refund, -spend
  balance   Int      // running balance AFTER this txn
  reason    String   // signup | purchase | audit:<type> | refund:<reason> | grant
  auditId   String?  // linked audit when reason starts with audit:/refund:
  meta      String?  // optional JSON (e.g. Stripe session id, pack id)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomAgent {
  id           String   @id @default(cuid())
  userId       String
  slug         String   @unique
  name         String
  specialty    String   // e.g. cybersecurity | ux | functional | ...
  description  String?
  checks       String   // JSON string[] of check ids from the catalog
  aiInstructions String?
  avatar       String   @default("🤖")
  accent       String   @default("#18e26a")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Audit {
  id             String   @id @default(cuid())
  userId         String
  targetUrl      String
  status         String   @default("pending") // pending | running | completed | failed
  type           String   @default("technical") // technical | persona | authenticated
  persona        String?  // persona slug (for persona/authenticated audits)
  mode           String   @default("standard") // quick | standard | deep
  agentsCount    Int      @default(5)
  durationMin    Int      @default(15)
  instructions   String?
  whitelistNotes String?
  hasCredentials Boolean  @default(false)
  allowWrites    Boolean  @default(false) // interactive workflow test (fill/submit forms)
  engine         String?  // playwright | mock
  shareId        String?  @unique // public read-only share token (null = private)
  source         String?  // ui | api | deploy-hook

  // persona/authenticated journey result (JSON JourneyResult)
  journeyData    String?
  // AES-GCM encrypted test credentials (authenticated audits); cleared after run
  credEnc        String?
  // snapshot of the custom marketplace agent used (JSON: name, checks[], aiInstructions, …)
  agentConfig    String?
  // intelligence layer: inferred SiteModel + agentic WorkflowResult (JSON)
  siteModel      String?
  workflowData   String?
  // strategy layer (Agent Néo): StrategyResult (JSON)
  strategyData   String?

  // JSON blobs (stringified) — SQLite has no native JSON
  scores         String?  // AuditScores
  pagesVisited   String?  // PageVisit[]
  timeline       String?  // TimelineEvent[]
  uxSuggestions  String?  // string[]
  summary        String?
  reportMarkdown String?
  fixPrompt      String?
  errorMessage   String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings    AuditFinding[]
  screenshots AuditScreenshot[]

  @@index([userId])
}

model AuditFinding {
  id                String  @id @default(cuid())
  auditId           String
  title             String
  severity          String  // critical | high | medium | low | info
  category          String  // functional | ui | ux | security | performance
  description       String
  evidence          String
  reproductionSteps String  // JSON string[]
  probableCause     String
  recommendedFix    String
  fixPromptBlock    String
  agent             String

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model AuditScreenshot {
  id      String  @id @default(cuid())
  auditId String
  label   String
  page    String
  src     String  // data URI or path
  caption String?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// Agent Smith Analytics — a site the user instruments with our snippet.
model TrackedSite {
  id        String   @id @default(cuid())
  userId    String
  domain    String
  key       String   @unique // public site key embedded in the snippet
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hits PageHit[]

  @@index([userId])
}

// One privacy-friendly pageview/event. No raw IP/cookie — only a daily-salted
// visitor hash. `event` = "pageview" or a custom conversion (e.g. signup, pay).
model PageHit {
  id          String   @id @default(cuid())
  siteKey     String
  path        String
  referrer    String?
  country     String?
  device      String?  // mobile | tablet | desktop
  visitorHash String   // sha256(ip+ua+key+day) — rotates daily, no PII stored
  isNew       Boolean  @default(false)
  event       String   @default("pageview")
  createdAt   DateTime @default(now())

  site TrackedSite @relation(fields: [siteKey], references: [key], onDelete: Cascade)

  @@index([siteKey, createdAt])
  @@index([siteKey, visitorHash])
}

// Fixed-row semaphore for the remote browser (Browserbase free tier ≈ 1
// concurrent session). N rows = BROWSER_CONCURRENCY slots; a session atomically
// claims a free/expired row before connecting and releases it on close. This
// serializes browser usage across serverless invocations so audits queue instead
// of colliding and falling back to mock.
model BrowserSlot {
  id        String    @id // "slot-0", "slot-1", …
  holder    String?   // label of the current holder (audit id / purpose)
  heldUntil DateTime? // lease expiry; null or past = free
  updatedAt DateTime  @updatedAt
}

// Anonymous "try it free" audits from the landing page. Doubles as an
// IP rate-limiter (count by ip over the last hour), a short cache (reuse a
// recent result for the same URL), and a top-of-funnel analytics signal.
model PublicAudit {
  id        String   @id @default(cuid())
  ip        String
  targetUrl String
  engine    String?  // playwright | mock
  overall   Int      @default(0)
  scores    String?  // AuditScores JSON
  teaser    String?  // JSON: { findings: [top 2], hiddenCount }
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([targetUrl, createdAt])
}

model AgentProfile {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  specialty   String
  testingStyle String
  price       String
  priceNote   String
  rating      Float   @default(5)
  reviews     Int     @default(0)
  accent      String
  avatar      String
  premium     Boolean @default(false)
  focus       String  // JSON Category[]
}
